PORT=3001
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:5173
MAX_VIEWERS=5
ROOM_IDLE_MINUTES=60
# Comma-separated ICE servers, example: stun:stun.l.google.com:19302
VITE_STUN_URLS=stun:stun.l.google.com:19302
# Optional TURN credentials for viewers behind restrictive NATs
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
# Optional Discord bot; disabled unless both are set
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional server ID: register /stream only in this server for quick testing
DISCORD_GUILD_ID=
